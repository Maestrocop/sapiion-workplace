# Copy to .env and fill in real values before running.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sapiion_workplace
PORT=4100

# Generate a strong random secret before running in production
JWT_SECRET=sapiion-workplace-dev-secret-change-in-production
JWT_EXPIRES_IN=2h

# Must be set to the exact frontend URL in production (no wildcard)
CORS_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# --- Optional OAuth (local email/password works without these) ---
# Microsoft Entra ID app registration (https://portal.azure.com)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4100/api/auth/microsoft/callback

# Google OAuth client (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback

# --- Optional mail relay (used for application-sending and password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Sapiion Workplace <no-reply@example.com>"
